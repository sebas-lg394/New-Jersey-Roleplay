import { SlashCommandBuilder } from 'discord.js';
import { createEmbed } from '../../utils/embeds.js';
import { getEconomyData, updateEconomyData } from '../../utils/economy.js';
import InteractionHelper from '../../utils/interactionHelper.js';
import { logger } from '../../utils/logger.js';

const MONEY_ROLE_ID = '1522572234370056438';

export default {
    data: new SlashCommandBuilder()
        .setName('adminmoney')
        .setDescription('Administrar el dinero de un usuario')
        .setDMPermission(false)

        .addSubcommand(subcommand =>
            subcommand
                .setName('add')
                .setDescription('Añadir dinero')
                .addUserOption(option =>
                    option
                        .setName('usuario')
                        .setDescription('Usuario')
                        .setRequired(true)
                )
                .addIntegerOption(option =>
                    option
                        .setName('cantidad')
                        .setDescription('Cantidad de dinero')
                        .setMinValue(1)
                        .setRequired(true)
                )
                .addStringOption(option =>
                    option
                        .setName('cuenta')
                        .setDescription('Cuenta')
                        .setRequired(true)
                        .addChoices(
                            { name: '💵 Wallet', value: 'wallet' },
                            { name: '🏦 Bank', value: 'bank' }
                        )
                )
        )

        .addSubcommand(subcommand =>
            subcommand
                .setName('remove')
                .setDescription('Quitar dinero')
                .addUserOption(option =>
                    option
                        .setName('usuario')
                        .setDescription('Usuario')
                        .setRequired(true)
                )
                .addIntegerOption(option =>
                    option
                        .setName('cantidad')
                        .setDescription('Cantidad de dinero')
                        .setMinValue(1)
                        .setRequired(true)
                )
                .addStringOption(option =>
                    option
                        .setName('cuenta')
                        .setDescription('Cuenta')
                        .setRequired(true)
                        .addChoices(
                            { name: '💵 Wallet', value: 'wallet' },
                            { name: '🏦 Bank', value: 'bank' }
                        )
                )
        ),

    category: 'Economy',

    async execute(interaction, config, client) {
        const deferred = await InteractionHelper.safeDefer(interaction);
        if (!deferred) return;

        // SOLO EL ROL AUTORIZADO
        if (!interaction.member.roles.cache.has(MONEY_ROLE_ID)) {
            return InteractionHelper.safeEditReply(interaction, {
                embeds: [
                    createEmbed({
                        title: '❌ Sin permisos',
                        description:
                            'No tienes el rol necesario para administrar el dinero.'
                    })
                ]
            });
        }

        const accion = interaction.options.getSubcommand();
        const usuario = interaction.options.getUser('usuario');
        const cantidad = interaction.options.getInteger('cantidad');
        const cuenta = interaction.options.getString('cuenta');

        if (usuario.bot) {
            return InteractionHelper.safeEditReply(interaction, {
                embeds: [
                    createEmbed({
                        title: '❌ Usuario inválido',
                        description: 'Los bots no pueden tener dinero.'
                    })
                ]
            });
        }

        const datos = await getEconomyData(
            client,
            interaction.guildId,
            usuario.id
        );

        if (!datos) {
            return InteractionHelper.safeEditReply(interaction, {
                embeds: [
                    createEmbed({
                        title: '❌ Error',
                        description: 'No se encontró la cuenta económica del usuario.'
                    })
                ]
            });
        }

        const saldoActual = Number(datos[cuenta] || 0);

        if (accion === 'remove' && cantidad > saldoActual) {
            return InteractionHelper.safeEditReply(interaction, {
                embeds: [
                    createEmbed({
                        title: '❌ Dinero insuficiente',
                        description:
                            `El usuario solo tiene **$${saldoActual.toLocaleString()}** en ${cuenta}.`
                    })
                ]
            });
        }

        const nuevoSaldo =
            accion === 'add'
                ? saldoActual + cantidad
                : saldoActual - cantidad;

        await updateEconomyData(
            client,
            interaction.guildId,
            usuario.id,
            {
                [cuenta]: nuevoSaldo
            }
        );

        logger.info(
            `[ECONOMY] ${accion.toUpperCase()} $${cantidad} ${cuenta} | Usuario: ${usuario.id} | Staff: ${interaction.user.id}`
        );

        const emoji = cuenta === 'wallet' ? '💵' : '🏦';

        return InteractionHelper.safeEditReply(interaction, {
            embeds: [
                createEmbed({
                    title: '💰 Dinero actualizado',
                    description:
                        `${emoji} Se han **${accion === 'add' ? 'añadido' : 'quitado'} $${cantidad.toLocaleString()}** ` +
                        `de ${usuario}.\n\n` +
                        `**Cuenta:** ${cuenta.toUpperCase()}\n` +
                        `**Saldo anterior:** $${saldoActual.toLocaleString()}\n` +
                        `**Nuevo saldo:** $${nuevoSaldo.toLocaleString()}`
                })
            ]
        });
    }
};
